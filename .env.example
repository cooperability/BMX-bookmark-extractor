# Copy to .env and fill in real values. Never commit .env.

# Neon Postgres (pgvector). Provision via the Vercel marketplace integration.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Login. Only these addresses can log in. Comma-separated.
ALLOWED_EMAILS=""
# Shared password for every allowed address. Unset means nobody can log in.
DEV_PASSWORD=""

# Claude, for enrichment and BMX triage. Phase 5.
ANTHROPIC_API_KEY=""

# Shared secret the cron worker sends to api/extract.py as x-internal-token.
# That function is never user-reachable. Phase 4.
INTERNAL_TOKEN=""
